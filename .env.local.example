# Supabase project URL
# Source: Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to expose to the browser)
# Source: Supabase Dashboard -> Project Settings -> API Keys -> anon/publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used only by lib/supabase/admin.ts
# for privileged operations (auth.admin.createUser, auth.admin.updateUserById).
# Source: Supabase Dashboard -> Project Settings -> API Keys -> service_role/secret key
SUPABASE_SECRET_KEY=

# Personal access token for non-interactive `supabase db push` / `supabase link`.
# Source: Supabase Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Used only by
# lib/anthropic/client.ts to generate all chat responses (CTX-05). Client
# context (public.client_files) is injected directly into the system prompt
# server-side — no external RAG service is involved.
# Source: Anthropic Console -> API Keys (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional override for the chat completion model. Defaults to
# claude-sonnet-4-5 in code when unset.
ANTHROPIC_CHAT_MODEL=
